# SecDeploy site config (example) — the ONE file that places the suite on your compute
# resources AND configures how `deploy` runs them.
#
#   suite.toml     pins WHAT versions (the immutable bill of materials)
#   secsite.toml   places them on YOUR compute resources + configures deploy (this file)
#
# Copy to `secsite.toml` and edit — or run `secdeploy configure` to generate one.
# secsite.toml is site-specific and gitignored (like your *.env files); the .example is tracked.
#
# With a secsite.toml in place, a routine `secdeploy deploy <target>` needs NO flags at all —
# everything a flag would otherwise ask for lives here instead. CLI flags still exist and
# OVERRIDE whatever this file sets, for one-off runs (e.g. a single dry-run with an extra
# --without you don't want to keep).
#
# NO SECRETS live here. The Hugging Face token, the SecCert CA passphrase, and SecAgent's client
# secret stay in the *.env files (deploy/macos/secrets.env,
# /etc/secsuite/*.env on fedora-fips) — see `secdeploy configure` and docs/*.md.
#
# If secsite.toml (and topology.toml) are BOTH absent, SecDeploy runs in single-host mode:
# every component lands on the machine you run `deploy` on, and every deploy option defaults
# off. You only need this file for multi-host, or simply to stop retyping deploy flags.
#
# A bare topology.toml (this file's placement-only predecessor) still works unchanged — see
# docs/topology.md — and still takes effect if that's all you have.
#
# Components belong to fixed TIERS (declared in suite.toml); you assign each tier to a
# resource:
#   identity   seccert, secsso, secdns   (trust / auth / naming — all optional infra)
#   inference  secllm                    (wants a resource with the "gpu" capability; may
#                                          span SEVERAL resources for N SecLLM instances)
#   gateway    secrouter
#   collab     secagent, secchat, secrecorder
#   edge       secproxy                  (optional infra — the suite's :443 front door)

# Internal DNS zone the suite resolves under (served by secdns). Component FQDNs are
# <component>.<domain>, e.g. secrouter.sec.internal.
domain = "sec.internal"

# Where secdns forwards NON-internal queries. Leave empty ([]) for a closed network.
upstream_dns = ["1.1.1.1"]

# ── Suite-wide deploy options ─────────────────────────────────────────────────────────
[deploy]
# Optional components to drop, e.g. when you already run your own CA/IdP/DNS — the same names
# `deploy --without seccert,secsso` takes (comma-separated there; a real array here).
without = []
# Control-host push mode: build each resource's bundle, rsync it to that resource's `ssh`
# endpoint (see below), and deploy remotely — what `deploy --ssh` does, without retyping it.
# Needs at least one resource below with an `ssh` endpoint set.
ssh = false

# ── Compute resources (hosts) ────────────────────────────────────────────────────────
[resources.core]
target = "fedora-fips"      # deploy mechanism: macos | fedora-fips
address = "10.0.0.5"        # how peer hosts reach this one (IP or resolvable name)
# ssh = "root@10.0.0.5"     # optional — set to enable ssh-push deploy to this host
capabilities = ["fips"]     # gpu | fips | arch tags

# Per-resource deploy options — commented here at their defaults. These differ per host (e.g.
# inference on the GPU box, TLS on the Mac), which is why they live on the resource instead of
# in the suite-wide [deploy] table above. Uncomment only what you need to change.
# with_inference = false      # stand up SecLLM here (fedora-fips only; see 'gpu' below)
# with_agent = false          # install SecAgent here as an on-demand pi harness (CLI / CI / MCP)
# configure_resolver = false  # point THIS host's resolver at secdns (multi-host — docs/topology.md)
# tls = false                 # macOS only: issue SecRecorder a SecCert cert via certbot
# configure_hosts = false     # macOS only: map host.docker.internal to 127.0.0.1 in /etc/hosts
# trust_ca = false            # macOS only: trust the SecCert root in the System keychain
# model_dir = ""              # macOS only, air-gapped: pre-downloaded model snapshots dir
# autostart_models = []       # SecLLM catalog ids to download + load at boot (e.g. ["fast"])

[resources.gpu]
target = "fedora-fips"
address = "10.0.0.6"
capabilities = ["fips", "gpu"]
# Standing up SecLLM itself is opt-in — without it, secdeploy still generates the DNS/env
# wiring for an externally-run SecLLM. Here it's turned ON, so this GPU box actually runs it:
with_inference = true
# model_dir = ""              # air-gapped hosts only — see docs/macos.md (macOS target only)
# autostart_models = ["fast"] # download + load "fast" at boot instead of waiting on the first request

# ── Tier → resource assignments ──────────────────────────────────────────────────────
# Multiple tiers may share one resource. Omit an all-optional tier (identity, edge) to skip
# that infrastructure. Every REQUIRED tier must be placed.
[groups.identity]
resource = "core"

[groups.gateway]
resource = "core"

[groups.collab]
resource = "core"

[groups.inference]
resource = "gpu"

# secproxy (edge) — the suite's one HTTPS front door for the fronted web/API services.
# Topology-gated only, no --with-* flag: it stands up the moment this tier is placed.
[groups.edge]
resource = "core"

# N-way inference: several SecLLM instances (stateless — no coordination needed), one per
# resource, each with its OWN with_inference toggle. Swap the single-resource form above for:
#
#   [resources.gpu2]
#   target = "fedora-fips"
#   address = "10.0.0.7"
#   capabilities = ["fips", "gpu"]
#   with_inference = true
#
#   [groups.inference]
#   resources = ["gpu", "gpu2"]

# ── Single-host variant ──────────────────────────────────────────────────────────────
# For one machine, define a single resource and point every tier at it:
#
#   [resources.local]
#   target = "macos"
#   address = "127.0.0.1"
#   capabilities = []
#   # tls = true
#   # configure_hosts = true
#   # trust_ca = true
#
#   [groups.identity]   { resource = "local" }
#   [groups.inference]  { resource = "local" }
#   [groups.gateway]    { resource = "local" }
#   [groups.collab]     { resource = "local" }
#
# …or just delete secsite.toml (and topology.toml) — that is exactly what single-host mode
# does for you, with every deploy option at its default.

# ── Optional: Kubernetes agent pool for SecChat coding agents ─────────────────────────
# When enabled, a coding agent whose launch environment is "pool" runs in a server-launched,
# ephemeral Kubernetes pod (the runnerd image) instead of the user's desktop. SecDeploy writes
# the SECCHAT_POOL_* env into secchat's .env AND emits the cluster manifests (namespace / Role +
# binding / ResourceQuota / NetworkPolicy) to <out>/addressing/secchat-pool.k8s.json for the
# operator to `kubectl apply`. Off by default — omit this whole section if you have no cluster.
# See docs/agent-pool.md.
#
# [secchat.pool]
# enabled = true
# image = "registry.internal/secchat-runnerd:1.0.0"  # the runnerd image (required when enabled)
# namespace = "secchat-pool"                          # where pool pods are created
# service_account = "secchat"                         # SecChat's ServiceAccount (create/delete pods)
# service_account_namespace = "secchat"               # ...and the namespace it lives in
# git_host = "git.sec.internal"                       # the enclave git host pods may reach
# secchat_url = ""                                    # cluster-internal URL a pod dials back (default: SecChat's own)
# cpu = "1"
# memory = "1Gi"
# max_pods = 20                                       # ResourceQuota pod cap for the pool namespace
# max_per_owner = 3                                   # per-user cap (SecChat's own admission)
# ttl_seconds = 3600                                  # hard pod TTL backstop
#
# # Turnkey knobs (all optional; default off = write manifests only):
# build_image = false                                 # build+push Dockerfile.runnerd (needs registry)
# registry = ""                                       # push destination when build_image
# apply = false                                       # kubectl apply the manifests during deploy
# kube_context = ""                                   # kubectl --context for apply/extraction
#
# # OUT-OF-CLUSTER SecChat (compose on the host — this suite's normal shape):
# api_server = "https://192.168.5.1:58483"            # k8s API reachable FROM the secchat container
# create_service_account = true                       # emit SA + token Secret; deploy mounts the credential
#
# # Analysis sidecar catalog — containers attachable to an agent's pod, sharing its /workspace.
# # Internet access for a pod is a PER-AGENT toggle in the SecChat UI, default OFF.
# [secchat.pool.analysis_images]
# rust = "secagent-analyzer-rust:local"

# ── Optional: 1:1 voice calls (secchat-mediad media relay + SecRecorder transcription) ────
# When enabled, SecDeploy adds a `mediad` compose service alongside SecChat (server-side WebRTC
# relay that records consented calls), a NEW `recordings` volume (distinct from `uploads`,
# mounted rw on both mediad and secchat), and writes SECCHAT_TRANSCRIBE_URL/SECCHAT_MEDIAD_*/
# SECCHAT_CALL_STUN into secchat's .env. secrecorder must NOT be in [deploy].without (voice
# transcription needs it — see docs/voice.md). Off by default.
#
# [secchat.voice]
# enabled = true
# image = "secchat-mediad:local"        # built via a [[builds]] entry below, or push your own
# token = ""                            # SECCHAT_MEDIAD_TOKEN — blank generates+persists one
# stun = ""                             # SECCHAT_CALL_STUN — suite-local ONLY; NEVER a public
#                                        # STUN server (leaks call metadata off-suite; CUI/air-
#                                        # gap posture). Empty is fine — LAN/VPN p2p usually
#                                        # connects via host/peer-reflexive candidates anyway.
# advertise_addr = "192.168.5.1"        # REQUIRED — the suite host's CROSS-HOST-reachable
#                                        # address, fed to Pion's SetNAT1To1IPs. Wrong value =
#                                        # relayed calls never connect from a second host.
# # media_port = 47020                  # UDP+TCP (Pion ICEUDPMux/SetICETCPMux); rarely changed
# # control_port = 47021                # compose-internal only, never published
# # max_legs_per_session = 8            # MEDIAD_MAX_LEGS_PER_SESSION — participants per call;
#                                        # raise for larger group calls, must be >= 2

# ── Audit syslog forwarding (optional) ─────────────────────────────────────────────────
# Suite-wide (like [deploy] above, not per-resource): forwards SecRouter's tamper-evident audit
# log to a syslog/SIEM sink in ADDITION to its own SQLite chain (AU-3.3.x/800-172 — see
# docs/compliance.md). Written as a documented `security.audit` fragment (secrouter-audit.json)
# for you to merge into SecRouter's SECROUTER_CONFIG — not env-var-driven, same as its OIDC
# fragment. Absent/empty syslog_host = no syslog sink at all (default; unchanged behavior).
#
# [audit]
# syslog_host = "siem.sec.internal"
# # syslog_port = 514                   # default
# # syslog_proto = "udp"                # "udp" or "tcp"
# # syslog_format = "json"              # "json" or "cef"

# ── Container builds (optional) ────────────────────────────────────────────────────────
# Images the deploy builds from fetched component checkouts (docker layer cache makes re-runs
# cheap; local-only by default — right for colima/k3s shared runtimes; push = true needs registry).
#
# [[builds]]
# name = "secchat-runnerd"                            # built as <name>:<tag> (tag defaults to local)
# component = "secchat"                               # fetched checkout = build context
# dockerfile = "Dockerfile.runnerd"
#
# [[builds]]
# name = "secchat-mediad"                             # the voice media relay (Go/Pion + ffmpeg)
# component = "secchat"
# dockerfile = "mediad/Dockerfile"
# context = "mediad"                                  # Dockerfile does `COPY go.mod go.sum ./`
#
# [[builds]]
# name = "secagent-analyzer-rust"
# component = "secagent"
# dockerfile = "docker/analyzer-rust.Dockerfile"

# ── Users & admin groups ───────────────────────────────────────────────────────────────
# Optional [[users]] blocks seed SSO logins. Each is provisioned into SecSSO (Authentik) and
# written to blueprints/users.generated.yaml with a one-time password (that generated file is
# gitignored — it holds secrets — so this real secsite.toml is too; keep both out of git).
#
# Every name in a user's `groups` becomes an Authentik group + membership. Admin access is
# per-service, gated on a named group (a valid login is necessary but not sufficient):
#
#   secrouter-admins  → the SecRouter admin console
#   secllm-admins     → the SecLLM admin console (SECLLM_ADMIN_GROUP)
#   secchat-admins    → the SecChat admin console + webhook management (SECCHAT_ADMIN_GROUP)
#
# Put a user in the group for each service they administer — e.g. an operator who runs
# everything gets all three. A user in none of them is a normal, non-admin member.
#
#   [[users]]
#   username = "austin"
#   name     = "Austin"
#   email    = "austin@example.mil"
#   groups   = ["secrouter-admins", "secllm-admins", "secchat-admins"]
#
#   [[users]]
#   username = "casey"
#   name     = "Casey"
#   groups   = []   # a normal member — can sign in, no admin consoles
