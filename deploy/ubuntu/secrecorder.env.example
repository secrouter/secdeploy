# SecRecorder (transcription) — Ubuntu/Debian. Copy to /etc/secsuite/secrecorder.env and edit.
# Optional service — `systemctl mask secrecorder.service` to skip it.
HOST=127.0.0.1
PORT=47003
WHISPER_BACKEND=faster-whisper
WHISPER_DEVICE=auto
WHISPER_MAX_UPLOAD_MB=0
# Diarization (optional) needs a Hugging Face token with the gated model accepted.
# HF_TOKEN=

# ── Optional SSO auth + summarization (both OFF by default; unset ⇒ off) ────────────────────
# When SecSSO is co-placed, secdeploy generates the OIDC issuer/client-id/audience/public-URL, the
# SecRouter-governed summarize endpoint, and the mirrored login-client secret into
# /etc/secsuite/secrecorder-addressing.env — layered ON TOP of this file by a second
# EnvironmentFile= in secrecorder.service — so you do NOT set those here. Set the OIDC vars below
# only for an EXTERNAL IdP (no SecSSO in the topology); the client id/audience are "secrecorder".
# SECRECORDER_OIDC_ISSUER=
# SECRECORDER_OIDC_CLIENT_ID=secrecorder
# SECRECORDER_OIDC_AUDIENCE=secrecorder
# SECRECORDER_OIDC_CLIENT_SECRET=
# SECRECORDER_PUBLIC_URL=https://secrecorder.sec.internal
#
# Session-cookie signing key — REQUIRED once SSO is on, and always set HERE (a local, unshared
# value that must stay STABLE across redeploys, so secdeploy never writes it into the per-deploy
# addressing env). Generate:  openssl rand -base64 36 | tr -d '\n'
# SECRECORDER_SESSION_SECRET=
#
# Summarization POSTs transcripts to an OpenAI-compatible endpoint. SECRECORDER_SUMMARIZE_ENDPOINT
# defaults to SecRouter's /v1 (governed + audited via X-Sec-Acting-User) through the addressing env
# above when SecRouter is placed; flip it on and set the model + a SecRouter-issued key to enable.
# SECRECORDER_SUMMARIZE_ENABLED=true
# SECRECORDER_SUMMARIZE_MODEL=          # a SecRouter catalog id
# SECRECORDER_SUMMARIZE_API_KEY=
# SECRECORDER_SUMMARIZE_PROMPT=
