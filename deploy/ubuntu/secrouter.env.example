# SecRouter (governed AI gateway) — Ubuntu/Debian. Copy to /etc/secsuite/secrouter.env and edit.
#
# Point at a hardened config with security.enabled=true, OIDC, egress allow-list, and
# tls.mode=frontend|native.
# Start from secrouter.config.hardened.example.json shipped in the SecRouter checkout.
SECROUTER_CONFIG=/etc/secsuite/secrouter.config.json
SECROUTER_PORT=47002
NODE_ENV=production
# On an Ubuntu Pro fips-updates host, Node links the system OpenSSL FIPS provider automatically;
# on stock Ubuntu/Debian this runs WITHOUT a FIPS-validated crypto boundary (see docs/ubuntu.md#fips
# — the ubuntu target warns rather than failing closed here, unlike fedora-fips).
#
# When topology.toml places a SecLLM pool, secdeploy ALSO generates
# /etc/secsuite/secrouter-addressing.env (SECROUTER_SECLLM_ENDPOINTS/_TOKEN, SECROUTER_EGRESS_
# FILE) and layers it on top of this file via a second EnvironmentFile= in secrouter.service —
# it wins over any of these keys it also sets. Don't hand-edit it; edit topology.toml and
# redeploy. See docs/fedora-fips.md#secrouter-egress-allow-list (identical mechanism on ubuntu).
