# SecRouter (governed AI gateway) — Fedora/FIPS. Copy to /etc/secsuite/secrouter.env and edit.
#
# Point at a hardened config with security.enabled=true, OIDC, egress allow-list, and
# tls.mode=frontend|native (SecRouter fails closed if FIPS is required but unavailable).
# Start from freerouter.config.hardened.example.json shipped in the SecRouter checkout.
FREEROUTER_CONFIG=/etc/secsuite/secrouter.config.json
SECROUTER_PORT=47002
NODE_ENV=production
# On a FIPS-mode host, Node links the system OpenSSL FIPS provider automatically.
