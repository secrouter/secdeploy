# secdns — internal DNS. Normally secdeploy GENERATES this file (and the zone) from your
# topology.toml at deploy time; this example is for reference / manual runs.
# Optional service — `systemctl mask secdns.service` to skip it.
SECDNS_DOMAIN=sec.internal
SECDNS_ZONE=/var/lib/secsuite/secdns/secdns.zone
# Upstream resolvers for non-internal names; leave empty for a fully closed network (refuse).
SECDNS_UPSTREAM=
SECDNS_PORT=53
SECDNS_ADMIN_BIND=127.0.0.1
SECDNS_ADMIN_PORT=47053
