[Unit]
Description=secdns — internal DNS for the SecRouter suite
Documentation=https://github.com/secrouter/secdns
After=network-online.target
Wants=network-online.target
PartOf=secsuite.target
Before=secrouter.service secrecorder.service

[Service]
Type=simple
User=secsuite-secdns
Group=secsuite-secdns
WorkingDirectory=/opt/secsuite/secdns
EnvironmentFile=/etc/secsuite/secdns.env
ExecStart=/opt/secsuite/secdns/.venv/bin/secdns serve
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# Bind the privileged DNS port (53) as an unprivileged user — nothing more.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=secsuite.target
