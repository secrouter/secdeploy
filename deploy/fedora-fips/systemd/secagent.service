[Unit]
Description=SecAgent — agentic harness (chat-ops, MR review) — Mattermost bridge
Documentation=https://github.com/secrouter/secagent
After=network-online.target secrouter.service
Wants=network-online.target
# Chat-triggered inference is routed through SecRouter (governed/audited) — bring it up first.
After=secrouter.service
PartOf=secsuite.target

[Service]
Type=simple
User=secsuite-secagent
Group=secsuite-secagent
WorkingDirectory=/opt/secsuite/secagent
EnvironmentFile=/etc/secsuite/secagent.env
# secdeploy-generated topology wiring (SecRouter LLM endpoint, SecSSO token URL, Mattermost
# URL/team, webhook secret) — present only when a topology.toml placed SecAgent here with
# --with-agent; the leading '-' makes it optional. systemd applies multiple EnvironmentFile=
# lines in order (later wins), so this — being second — is authoritative over secagent.env
# for any key both define. See docs/fedora-fips.md#secagent-and-mattermost.
EnvironmentFile=-/etc/secsuite/secagent-addressing.env
ExecStart=/opt/secsuite/secagent/.venv/bin/secagent chat serve --port 8070
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/secsuite/secagent

[Install]
WantedBy=secsuite.target
