[Unit]
Description=SecRouter — governed AI gateway
Documentation=https://github.com/secrouter/secrouter
After=network-online.target seccert.service
Wants=network-online.target
# SecCert issues the suite's certs, so bring it up first.
After=seccert.service
PartOf=secsuite.target

[Service]
Type=simple
User=secsuite-secrouter
Group=secsuite-secrouter
WorkingDirectory=/opt/secsuite/secrouter
EnvironmentFile=/etc/secsuite/secrouter.env
# secdeploy-generated topology wiring (SecLLM pool/token/egress allow-list path) — present only
# when a topology.toml placed SecRouter + a SecLLM pool here; the leading '-' makes it optional
# so single-host / no-topology deploys (no such file) are unaffected. systemd applies multiple
# EnvironmentFile= directives in listed order with later files overriding same-named keys, so
# this — being second — is authoritative over secrouter.env for any key both define.
EnvironmentFile=-/etc/secsuite/secrouter-addressing.env
# SecRouter is a zero-runtime-dependency Node app (node:sqlite builtin; needs Node >= 24).
ExecStart=/usr/bin/node /opt/secsuite/secrouter/dist/server.js
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
ReadWritePaths=/var/lib/secsuite/secrouter

[Install]
WantedBy=secsuite.target
