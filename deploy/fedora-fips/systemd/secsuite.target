[Unit]
Description=SecRouter secure-AI suite (secdns + SecCert + SecRouter + SecRecorder)
Documentation=https://github.com/secrouter/secdeploy
# secdns (internal DNS) and SecCert (CA) come up first; SecRecorder is optional. Any unit
# not installed on this host is simply skipped (Wants= is a weak dependency).
Wants=secdns.service seccert.service secrouter.service secrecorder.service
After=secdns.service seccert.service

[Install]
WantedBy=multi-user.target
