[Unit]
Description=secproxy — edge reverse proxy (Caddy) for the SecRouter suite
Documentation=https://github.com/secrouter/secproxy
# Caddy's automatic HTTPS dials SecCert's ACME directory at startup, and its Host-routed
# reverse_proxy site blocks address backends by the names secdns serves — bring both up
# first, same reasoning as secrouter.service's "After=seccert.service" above.
After=network-online.target secdns.service seccert.service
Wants=network-online.target
PartOf=secsuite.target

[Service]
Type=simple
User=secsuite-secproxy
Group=secsuite-secproxy
WorkingDirectory=/opt/secsuite/secproxy
# Caddy resolves its default data/config dirs ($HOME/.local/share/caddy — the ACME account
# key + issued cert/key storage — and $HOME/.config/caddy — the autosaved running config)
# from $HOME. Set it explicitly to this user's state dir rather than relying on the system
# user's passwd entry, so that state stays inside ReadWritePaths below.
Environment=HOME=/var/lib/secsuite/secproxy
# Caddy is an upstream Go binary, not something secdeploy builds from a pinned checkout like
# the rest of SERVICES (there is no secproxy source to compile — see secdeploy's
# targets/fedora_fips.py and secproxy's own README). Installed from Caddy's official
# Fedora/RHEL package (the @caddy/caddy COPR: see docs/fedora-fips.md#secproxy-edge-reverse-proxy),
# pinned to the 2.8 line to match secproxy's own Dockerfile (FROM caddy:2.8-alpine) — a
# one-time, operator-run prerequisite, the same way node/npm and uv are provisioned before
# secrouter.service / the uv-based units can run (see docs/fedora-fips.md's Runtimes step).
ExecStart=/usr/bin/caddy run --config /etc/secsuite/Caddyfile
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# Bind the privileged HTTPS/HTTP ports (443 for TLS, 80 for the ACME HTTP-01 challenge and
# the automatic HTTP->HTTPS redirect) as an unprivileged user — nothing more. Exactly the
# same pattern secdns.service uses to bind :53.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening (identical to secdns.service)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# Unlike secdns (stateless beyond reading its zone file), Caddy persists ACME account/cert
# material and an autosaved config under $HOME (set above) — grant it write access there.
ReadWritePaths=/var/lib/secsuite/secproxy

[Install]
WantedBy=secsuite.target
