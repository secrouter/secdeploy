[Unit]
Description=secproxy — edge reverse proxy (nginx) for the SecRouter suite
Documentation=https://github.com/secrouter/secproxy
# nginx reverse-proxies the fronted backends by the names secdns resolves, and serves TLS with
# the SAN cert SecDeploy issues from SecCert at deploy time — bring both up first, same
# reasoning as secrouter.service's "After=seccert.service" above.
After=network-online.target secdns.service seccert.service
Wants=network-online.target
PartOf=secsuite.target

[Service]
Type=simple
User=secsuite-secproxy
Group=secsuite-secproxy
WorkingDirectory=/opt/secsuite/secproxy
# nginx is an upstream package (dnf install -y nginx), not something secdeploy builds from a
# pinned checkout like the rest of SERVICES (there is no secproxy source to compile — see
# secdeploy's targets/fedora_fips.py and secproxy's own README). It's installed alongside
# certbot as a one-time deploy prerequisite, the same way node/npm and uv are provisioned
# before secrouter.service / the uv-based units can run (see docs/fedora-fips.md's Runtimes
# step). nginx is the secproxy runtime specifically for FIPS: it links the system OpenSSL,
# which is FIPS-validated in FIPS mode (the reason the suite standardized on it for edge TLS).
#
# The config is a COMPLETE nginx config generated by secdeploy (wiring.nginx_conf_text) and
# installed to /etc/secsuite/nginx-secproxy.conf; -t validates it first (fails closed if the
# SecCert-issued cert isn't in place yet), then run it in the foreground under systemd.
ExecStartPre=/usr/sbin/nginx -t -c /etc/secsuite/nginx-secproxy.conf
ExecStart=/usr/sbin/nginx -c /etc/secsuite/nginx-secproxy.conf -g 'daemon off;'
ExecReload=/usr/sbin/nginx -s reload -c /etc/secsuite/nginx-secproxy.conf
Restart=on-failure
RestartSec=3

# Bind the privileged HTTPS/HTTP ports (443 for TLS, 80 for the ACME HTTP-01 challenge and
# the automatic HTTP->HTTPS redirect) as an unprivileged user — nothing more. Exactly the
# same pattern secdns.service uses to bind :53.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening (identical to secdns.service)
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
# ProtectSystem=strict makes /var and /etc read-only, but nginx needs to write its pid, error/
# access logs, and its temp dirs (client-body/proxy/fastcgi/uwsgi/scgi), and to read/serve the
# ACME-challenge webroot — the generated config points ALL of those into the state dir below,
# so no default nginx path (/var/log/nginx, /var/lib/nginx, /run) is ever touched.
ReadWritePaths=/var/lib/secsuite/secproxy

[Install]
WantedBy=secsuite.target
