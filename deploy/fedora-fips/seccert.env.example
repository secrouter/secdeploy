# SecCert (internal ACME CA) — Fedora/FIPS. Copy to /etc/secsuite/seccert.env and edit.
SECCERT_DATA_DIR=/var/lib/secsuite/seccert
SECCERT_EXTERNAL_URL=https://ca.internal.example
SECCERT_HOST=127.0.0.1
SECCERT_PORT=14000
SECCERT_CA_KEY_TYPE=ecdsa-p384
SECCERT_LEAF_DAYS=90
# REQUIRED in production: set a strong admin token.
SECCERT_ADMIN_TOKEN=
# Encrypt the CA private keys at rest.
SECCERT_CA_PASSPHRASE=
# Terminate TLS natively (self-issued) or run behind a FIPS-validated proxy and set 'none'.
SECCERT_TLS_MODE=native
