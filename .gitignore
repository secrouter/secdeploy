# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/
.pytest_cache/

# SecDeploy working state — checkouts, built images, and release bundles
work/
out/
*.tar
*.tar.zst
*.qcow2
SHA256SUMS

# Encrypted backups (default to out/backups/, but never commit one wherever it lands — it
# holds the suite's data + secrets + CA keys) and the transient plaintext staging dir a
# backup/restore creates (normally wiped in a finally:, ignored in case a run is killed).
*.tar.cms
.secdeploy-backup-*/
.secdeploy-restore-*/

# local env overrides
*.env
!*.env.example

# site placement — operator-specific, like the env files (the .example is tracked)
topology.toml
!topology.toml.example

# unified site config (placement + deploy options) — operator-specific, like the env files
# (the .example is tracked)
secsite.toml
!secsite.toml.example

# Sphinx
docs/_build/

# macOS
.DS_Store
